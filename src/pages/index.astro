<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 28px; }
  .eyebrow {
    font-family: var(--font-sans); font-size: 11px; letter-spacing: 0.32em;
    text-transform: uppercase; color: var(--faint);
    display: flex; align-items: center; gap: 12px; margin: 0 0 22px;
  }
  .eyebrow.center { justify-content: center; }
  .eyebrow .line { display: inline-block; width: 38px; height: 1px; background: linear-gradient(90deg, var(--cyan), var(--violet)); }
  .pill {
    letter-spacing: 0.08em; font-size: 10px; border: 1px solid rgba(103,232,249,0.35);
    padding: 6px 12px; border-radius: 999px; color: var(--cyan);
    background: rgba(103,232,249,0.07); display: inline-flex; align-items: center; gap: 7px;
  }
  .pill i { width: 6px; height: 6px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 10px #4ade80; animation: pulse 2s infinite; }
  @keyframes pulse { 50% { opacity: 0.35; } }
  h1 {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(34px, 5.4vw, 64px); line-height: 1.06; letter-spacing: -0.01em; margin: 0 0 20px;
  }
  .h1-sub { display: block; font-family: var(--font-sans); font-weight: 300; font-size: clamp(15px, 1.8vw, 19px); letter-spacing: 0.02em; color: var(--muted); margin-top: 16px; }
  .h2 { font-family: var(--font-display); font-weight: 600; font-size: clamp(26px, 3.6vw, 44px); line-height: 1.12; margin: 0 0 28px; }
  .grad { background: var(--grad-future); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .serif { font-style: italic; font-weight: 400; color: var(--gold); }
  .lead { color: var(--muted); font-size: 16.5px; line-height: 1.78; max-width: 54ch; font-weight: 300; }
  .lead strong { color: var(--text); font-weight: 500; }
  .muted { color: var(--muted); font-weight: 300; }
  .center { text-align: center; }
  .mono { font-family: var(--font-sans); font-size: 10px; letter-spacing: 0.22em; color: var(--faint); }

  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; backdrop-filter: blur(20px); background: rgba(5,6,14,0.6); border-bottom: 1px solid var(--line); }
  .nav-inner { max-width: 1200px; margin: 0 auto; padding: 15px 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .brand-mark {
    font-family: var(--font-display); font-size: 12px; font-weight: 700;
    padding: 9px 11px; border-radius: 12px; color: #06121a;
    background: var(--grad-future); box-shadow: 0 0 24px rgba(103,232,249,0.35);
  }
  .brand-text { font-family: var(--font-sans); letter-spacing: 0.24em; font-size: 13px; font-weight: 600; }
  .brand-text .dot { color: var(--cyan); }
  .links { display: flex; gap: 26px; }
  .links a { text-decoration: none; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); font-family: var(--font-sans); }
  .links a:hover { color: var(--cyan); }

  .btn-neon, .btn-outline, .btn-ghost {
    font-family: var(--font-sans); font-size: 13px; font-weight: 600; letter-spacing: 0.06em;
    text-transform: uppercase; text-decoration: none; border-radius: 999px;
    padding: 15px 28px; display: inline-flex; align-items: center; gap: 8px;
    transition: transform 0.25s, box-shadow 0.25s, background 0.25s; white-space: nowrap;
  }
  .btn-neon { background: var(--grad-future); color: #06121a; border: 1px solid rgba(255,255,255,0.3); box-shadow: 0 12px 44px rgba(103,232,249,0.3); }
  .btn-neon:hover { transform: translateY(-2px); box-shadow: 0 18px 60px rgba(167,139,250,0.4); }
  .btn-outline { border: 1px solid rgba(103,232,249,0.35); color: var(--cyan); background: rgba(103,232,249,0.05); }
  .btn-outline:hover { background: rgba(103,232,249,0.12); transform: translateY(-2px); }
  .btn-ghost { border: 1px solid var(--line); padding: 11px 22px; color: var(--text); background: var(--surface); font-size: 12px; }
  .btn-ghost:hover { border-color: rgba(103,232,249,0.5); color: var(--cyan); }
  .btn-outline.small { padding: 11px 20px; font-size: 12px; }

  .hero { position: relative; padding: 150px 0 30px; overflow: hidden; }
  .hero-grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(rgba(103,232,249,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(103,232,249,0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(760px 520px at 50% 18%, black 30%, transparent 75%);
  }
  .orb { position: absolute; border-radius: 50%; filter: blur(70px); pointer-events: none; }
  .orb-a { width: 520px; height: 520px; right: -140px; top: -120px; background: radial-gradient(circle, rgba(167,139,250,0.28), transparent 65%); }
  .orb-b { width: 420px; height: 420px; left: -160px; top: 240px; background: radial-gradient(circle, rgba(103,232,249,0.18), transparent 65%); }
  .hero-content { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 56px; align-items: center; position: relative; }
  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin: 30px 0 36px; }
  .cta-row.center { justify-content: center; }
  .stats { display: flex; border-top: 1px solid var(--line); }
  .stats div { padding: 20px 32px 0 0; margin-right: 32px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; }
  .stats div:last-child { border: none; }
  .stats strong { font-family: var(--font-display); font-size: 32px; font-weight: 600; background: var(--grad-future); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .stats span { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--faint); font-family: var(--font-sans); }

  .hero-right { position: relative; }
  .hud-card {
    border: 1px solid rgba(103,232,249,0.22); border-radius: 24px; overflow: hidden;
    background: linear-gradient(180deg, rgba(103,232,249,0.07), rgba(167,139,250,0.04));
    box-shadow: 0 0 0 1px rgba(0,0,0,0.4), 0 30px 90px rgba(0,0,0,0.55), 0 0 70px rgba(103,232,249,0.08);
    backdrop-filter: blur(14px);
  }
  .hud-top { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--line); }
  .status { font-family: var(--font-sans); font-size: 10px; letter-spacing: 0.2em; color: #9be8a8; display: flex; align-items: center; gap: 8px; }
  .status i { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 12px #4ade80; animation: pulse 2s infinite; }
  .hud-photo {
    aspect-ratio: 1/1;
    background: linear-gradient(180deg, #0d1226, #070912);
    border-bottom: 1px solid var(--line); position: relative; overflow: hidden;
  }
  .hud-photo img { width: 100%; height: 100%; object-fit: cover; }
  .hud-bottom { display: flex; justify-content: space-between; align-items: center; padding: 18px 20px; gap: 12px; }
  .hud-bottom .role { margin: 0; font-weight: 600; font-family: var(--font-sans); font-size: 15px; }
  .hud-bottom .focus { margin: 4px 0 0; color: var(--faint); font-size: 12.5px; }
  .socials { display: flex; gap: 8px; }
  .socials a {
