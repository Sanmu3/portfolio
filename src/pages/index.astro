  </main>

  <footer>
    <div class="container foot-grid">
      <div class="foot-brand">
        <span class="brand-mark">MM</span>
        <div>
          <p class="foot-name">Muhammad Mujahid Muslim</p>
          <p class="foot-sub">Frontend & Mobile Developer — Karawang, ID</p>
        </div>
      </div>
      <nav class="foot-nav">
        <a href="#tentang">Tentang</a>
        <a href="#keahlian">Keahlian</a>
        <a href="#pengalaman">Pengalaman</a>
        <a href="#karya">Karya</a>
        <a href="#kontak">Contact Me</a>
      </nav>
      <div class="foot-meta">
        <a href="mailto:mujahidmuslim0@gmail.com" target="_blank" rel="noopener noreferrer">mujahidmuslim0@gmail.com</a>
        <a href="#top">Kembali ke atas ↑</a>
      </div>
    </div>
    <div class="container foot-base">
      <p>© 2026 Muhammad Mujahid Muslim — Crafted with precision.</p>
